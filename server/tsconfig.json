{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",                            
    "paths": {
      "@form-builder/validation": ["../packages/validation/src"]
    }
  },
  "include": ["src/**/*"],
  "files": ["src/types/index.d.ts"]
}
